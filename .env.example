# ============================================================
# Brand & Content
#
# FINKNOW-Brand ist im Repo unter brand/brand.yaml und wird ins
# Docker-Image (ghcr.io/finnofleet/ff-finknow) gebacken.
# Default-Content (Hauptrepo) ist NICHT im Image — wird lokal aus
# content/ gelesen.
#
# Deployment via Helm-Chart auf Kubernetes (IBM Cloud):
#   deploy/helm/finknow — Doku: deploy/RUNBOOK.md
#
# Optional: BRAND_CONFIG_PATH überschreibt den Pfad zur brand.yaml
# (default: ./brand/brand.yaml).
# ============================================================

# ============================================================
# Auth — OIDC (Keycloak)
# ============================================================
#
# FINKNOW ist OIDC-only (Keycloak hinter Entra). Rolle = Keycloak (Source of
# Truth), gemappt aus den Token-Claims.

# Issuer = Keycloak-Realm-URL. In Prod ZWINGEND https.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Mapping Keycloak-Rolle/-Gruppe → App-Rolle. Nur „erhebende" Rollen nötig
# (alles andere = learner).
OIDC_ROLE_MAP=finknow-curator:curator,finknow-admin:admin

# --- Scope-Achsen Land/Rechtseinheit (ADR 0007 §3, Claim-Gate) ---
#
# `land` (aus dem `country`-Claim) und `bu` (aus dem via OIDC_ENTITY_CLAIM
# benannten Claim) laufen beim Login durch ein Gate (lib/auth/provider/oidc/
# claim-gate.ts): nur ein AUFLÖSBARER Wert wird nach profiles.land/.bu
# geschrieben. Ein unbekannter Claim-Wert wird als „[oidc-claims]"-Warnung
# geloggt (mit dem Rohwert) und NICHT gespeichert — ein bestehender, korrekt
# gesetzter Wert wird dadurch nie überschrieben. Konsequenz eines
# unaufgelösten Werts: der Scope-Filter ist strikt, die betroffene Person
# fällt lautlos aus jeder scoped Compliance-Auswertung heraus (sichtbar
# gemacht über die „Unvollständige Zuordnung"-Anzeige auf
# /manage/pflichtkurse). WICHTIG: oidcConfig() cached für die Prozess-
# Laufzeit — eine Änderung dieser Vars braucht einen Pod-Restart, kein
# reines Config-Update reicht.

# Optional: Name des Claims mit der Rechtseinheit/Gesellschaft (z. B.
# "legal_entity"). UNGESETZT (Default) = die bu-Achse wird GAR NICHT aus dem
# Token gefüllt, profiles.bu bleibt unberührt (heutiges Verhalten). Erst das
# Setzen aktiviert die Achse.
# OIDC_ENTITY_CLAIM=legal_entity

# Mapping IdP-Entity-Claim-Wert → App-Entity-Token, Format
# "claimWert:AppToken", kommasepariert. Schlüssel case-insensitiv.
# LEER (Default) = Pass-Through — der Rohwert des Claims wird unverändert
# übernommen. GESETZT = Allowlist — jeder nicht gelistete Wert gilt als
# "unmapped" und wird NICHT gespeichert.
# n:1 ist ausdrücklich erlaubt und der eigentliche Zweck dieser Map: mehrere
# IdP-Gesellschaften dürfen auf denselben App-Token zusammenlaufen. Das
# fängt den anstehenden Merger auf (viele heutige Rechtseinheiten werden bis
# Ende 2027 zu FINNOFLEET Deutschland/Schweiz/Luxemburg konsolidiert) app-
# seitig ab, OHNE auf einen IdP-Umbau warten zu müssen — ein Env-Var-Tausch,
# kein Code-Change.
# OIDC_ENTITY_MAP=ff-de-nord:FFDE,ff-de-sued:FFDE,ff-ch-01:FFCH

# Optional: Mapping IdP-`country`-Claim-Wert → Land-Token, gleiches Format.
# Die bekannten Land-Tokens (DE/CH/LUX, siehe lib/land-tokens.ts) lösen sich
# IMMER von selbst auf — diese Map ist nur nötig, um abweichende IdP-
# Schreibweisen zu übersetzen (Klassiker: der IdP liefert das ISO-Kürzel
# "LU", der App-Token lautet aber "LUX"). Eine gesetzte Map schaltet das
# eigene Vokabular NIE ab.
# OIDC_LAND_MAP=LU:LUX

# Optional: Scopes (Default "openid profile email").
# OIDC_SCOPES=openid profile email
# Secret zum Signieren des Session-Cookies (min. 16 Zeichen). Fällt sonst auf
# PAYLOAD_SECRET zurück.
# OIDC_SESSION_SECRET=
# Session-Lebensdauer in Sekunden (Default 28800 = 8h).
# OIDC_SESSION_MAX_AGE_SEC=28800
# Öffentliche Basis-URL für die exakte redirect_uri. In Prod ZWINGEND setzen
# (wird nicht aus Request-Headern abgeleitet).
OIDC_REDIRECT_BASE=
# NUR LOKAL: erlaubt http-Issuer (Keycloak ohne TLS). In Prod NIE setzen.
# OIDC_ALLOW_INSECURE=false

# ============================================================
# Datenbank (Postgres)
# ============================================================

# Postgres-Connection (Drizzle-Migrationen + Queries).
# Beispiel: postgres://USER:PASS@HOST:5432/DB?sslmode=require
DATABASE_URL=

# ============================================================
# DB-Bootstrap beim Boot (lib/db/auto-migrate.ts) — optional
#
# Läuft bei JEDEM Server-Start automatisch (kein manuelles
# `npm run db:bootstrap` nötig) und hat zwei GETRENNTE Notausstiege für zwei
# verschiedene Anliegen: Migrationen ändern das SCHEMA, die Initializer
# (lib/db/initializers) stellen INHALTE her, die der Code als vorhanden
# voraussetzt — allen voran die Rollen-Matrix (roles/role_capabilities), an
# der zur Laufzeit JEDE Berechtigung hängt. Beide Flags sind unabhängig
# voneinander schaltbar.
# ============================================================

# Notausstieg NUR für die Schema-Migrationen (Drizzle + Payload). Das Schema
# bleibt unberührt — gedacht für den Regelfall „Boot-Migration klemmt, DB ist
# aber schon da". Die Initializer laufen dabei ganz normal weiter. Default:
# false (Migrationen laufen).
# SKIP_MIGRATIONS=true

# ⚠️ Notausstieg NUR für die DB-Initializer — ein GETRENNTER Schalter von
# SKIP_MIGRATIONS oben, nicht dessen Ersatz. Es gibt keinen Code-seitigen
# Fallback mehr für Berechtigungen: SKIP_DB_INIT=true bedeutet deshalb, dass
# NIEMAND mehr irgendeine Permission hat, bis die Initializer nachgeholt
# werden. Nur setzen, wenn die Initializer selbst klemmen (z. B. weil das
# Schema unvollständig ist) — nicht als genereller Notausstieg. Default:
# false (Initializer laufen).
# SKIP_DB_INIT=true

# ============================================================
# Payload CMS
# ============================================================

# Interner JWT-Secret für Payload-eigene Sessions.
# Generieren mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WICHTIG: in Production identisch über alle App-Container-Replikas, sonst
# invalidieren sich Editor-Sessions gegenseitig.
PAYLOAD_SECRET=

# Hinweis: Das Payload-Admin (/admin) ist headless abgeschaltet (Proxy leitet
# auf /manage). Der SSO-Zugang ins Payload-Admin läuft über das OIDC-Session-
# Cookie (payload/collections/users.ts → oidc-Strategy); nur curator/admin.

# ============================================================
# Bundle-Storage (Authoring Source-of-Truth, ADR 0001)
# ============================================================

# Verzeichnis, in dem hochgeladene Kurs-Bundles byte-treu als durable
# Source-of-Truth liegen (Payload/Postgres ist der daraus generierte Index).
# Layout: ${BUNDLE_STORAGE_DIR}/<slug>/<version>/<bundle-relativer-Pfad>
# In Production auf ein PERSISTENTES Volume zeigen lassen (Kubernetes PVC),
# sonst gehen Bundles bei Container-Redeploys verloren. Ohne Wert: Fallback
# auf .bundle-storage/ im Projekt-Root (nur Dev).
BUNDLE_STORAGE_DIR=

# Verzeichnis für hochgeladene Media-Dateien (Bilder). Default: public/media.
# Serving läuft über /api/media/file/<name> (Payload-Route), NICHT Next-Static
# /media/ — der Pfad ist also frei wählbar und nicht an /public gebunden.
# In Production auf ein PERSISTENTES, für die Container-UID (1001) beschreibbares
# Verzeichnis zeigen lassen, sonst gehen Bilder bei Redeploys verloren. Am
# einfachsten ein Unterordner des schon durablen Bundle-Storage-Volumes:
#   MEDIA_STORAGE_DIR=/app/bundle-storage/_media
# Dann braucht es KEINEN separaten Media-Mount und KEINEN chown.
MEDIA_STORAGE_DIR=

# ============================================================
# KI-Tutor (ADR 0002) — optional
#
# Der Tutor ist deploymentweit OPTIONAL. Fehlt LLM_API_KEY,
# ist nur der Tutor deaktiviert — Annotations/Notizen/Markierungen
# laufen ohne LLM weiter. Kein Fehler, kein Absturz.
#
# Für den FinKnow-Handover: eigenes Provider-Konto anlegen, Key
# hier eintragen — ein Env-Var-Tausch, kein Code-Change (analog
# zu DB/Storage-Keys).
# ============================================================

# Provider-API-Key. PFLICHT für den Tutor — fehlt er, bleibt der Tutor AUS.
# Kein Default. Key beim Anbieter (Anthropic) anlegen:
# https://console.anthropic.com/settings/keys
LLM_API_KEY=

# LLM-Provider. Default: anthropic (einziger v1-Provider).
LLM_PROVIDER=anthropic

# API-Basis-URL. Default: https://api.anthropic.com
# Überschreibbar für einen EU-/CH-Region- + Zero-Data-Retention-Pfad
# (z. B. ein Anthropic-kompatibles Gateway / Proxy). User-Notizen und
# -Fragen sind persönliche Daten → bei Datenschutzbedarf ZDR-Pfad bevorzugen.
LLM_BASE_URL=https://api.anthropic.com

# Modell-ID. Default: claude-haiku-4-5 (günstigster Tier, für Basis-
# Erklärungen ausreichend). Ggf. auf claude-sonnet-4-6 hochstufen nach Messung.
LLM_MODEL=claude-haiku-4-5

# max_tokens-Cap pro Tutor-Antwort (Kosten-Hebel). Default: 1024.
LLM_MAX_TOKENS=1024

# ============================================================
# RAG-Index für den KI-Tutor (ADR 0003) — optional
#
# Embeddings für content-gegroundetes Retrieval. Ein EIGENES Konto/Key,
# getrennt vom LLM_API_KEY oben. Fehlt VOYAGE_API_KEY, ist nur die
# RAG-Indexierung aus — der Tutor läuft weiter (nicht-gegroundeter Pfad),
# Uploads laufen durch, Kurse bleiben „needs-reindex" bis ein Key da ist
# (dann: POST /api/authoring/reindex ohne slug = Backfill aller Kurse).
#
# Key anlegen: https://dashboard.voyageai.com → API Keys (Voyage gehört
# zu MongoDB; Free-Tier mit Gratis-Kontingent zum Starten).
# ============================================================

# Voyage-API-Key. Fehlt er → RAG-Indexierung AUS (kein Fehler). Kein Default.
VOYAGE_API_KEY=

# Embedding-Provider. Default: voyage (einziger v1-Provider).
EMBEDDING_PROVIDER=voyage

# Modell-ID. Default: voyage-3.5-lite (günstigster Tier, schlägt OpenAI-v3-large).
# Auf voyage-3.5 (höhere Qualität) hochstufbar OHNE DB-Migration — beide liefern
# 1024 Dimensionen, was das lesson_chunks-Schema festnagelt.
EMBEDDING_MODEL=voyage-3.5-lite

# API-Basis-URL. Default: https://api.voyageai.com (überschreibbar für Proxy).
EMBEDDING_BASE_URL=https://api.voyageai.com

# RAG-Retrieval-Schwelle (ADR 0003) — Rausch-Filter für die Kontext-Injektion:
# Kurs-Chunks mit Cosine-Score unter diesem Wert sind zu schwach und gehen NICHT
# in den Prompt. KEIN Scope-Router (gegroundet vs. Allgemeinwissen ist jetzt
# user-initiiert über den Button „Allgemeinwissen ergänzen"). Bleibt nichts
# übrig → Fallback auf die aktuelle Lektion. Default 0.4 (gültig: 0 < x < 1).
RAG_RELEVANCE_THRESHOLD=0.4

# MCP-Authoring-Server (PoC) — exponiert die Content-Management-Pipeline als
# Model-Context-Protocol-Tools unter POST /api/mcp/mcp (Streamable-HTTP), damit
# MCP-fähige Clients (Claude Desktop, Gruppen-Agents) Kurse anlegen/ändern/
# publishen. Aus, solange nicht explizit aktiviert. Auth = Authoring-Bearer-Token
# (cat_…, curator/admin) wie bei den anderen Authoring-Endpoints.
MCP_ENABLED=false

# Öffentliche Basis-URL der App, die das MCP-Tool request_asset_upload_url in die
# vor-signierte Asset-Upload-URL schreibt. NUR nötig, wenn der LB die Forwarding-
# Header (X-Forwarded-Host/-Proto) strippt/umschreibt — sonst wird die URL daraus
# automatisch abgeleitet. Ohne Schema-/Trailing-Slash-Eigenheiten, z. B.:
#   AUTHORING_PUBLIC_URL=https://app.finknow.ch
AUTHORING_PUBLIC_URL=

# ============================================================
# Aufbewahrungsfrist Nachweise (ADR 0006) — FALLBACK
#
# Der wirksame Wert kommt bevorzugt aus den Policy-Einstellungen in der DB
# (/manage/einstellungen): dort kann der Datenschutzbeauftragte die Frist
# ohne Deployment anpassen, und jede Aenderung wird protokolliert
# (audit_log, `setting.changed`). Diese Var gilt nur, solange dort nichts
# eingetragen ist; ohne beides gelten 3 Jahre (§ 195/§ 199 BGB).
# ============================================================

# FINKNOW_RETENTION_YEARS=3
