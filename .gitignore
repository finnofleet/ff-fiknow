# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright e2e
/e2e/.auth/
/e2e/screenshots/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# bundle-storage (Dev-Fallback; in Prod via BUNDLE_STORAGE_DIR auf Volume)
/.bundle-storage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# lokale Testartefakte (Entwurfs-Policies, Seed-Bundles) — nie committen
/local-test/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: persönliche Overrides ignorieren, geteiltes settings.json tracken
.claude/settings.local.json

# Drizzle migrations werden committed (auto-migrate beim App-Start braucht
# sie zur Runtime im Container — siehe lib/db/auto-migrate.ts und instrumentation.ts)
# /drizzle/  # bewusst nicht gitignored

# Payload auto-generates type definitions on every dev start —
# kein Commit, sondern lokal regenerieren via `npx payload generate:types`.
/payload-types.ts

# Deployment-spezifische Helm-Werte enthalten den echten Cluster-Host/-Issuer
# und bleiben lokal (nicht ins öffentliche Repo). Als Vorlage dient die
# committete values-ibm-production.example.yaml — kopieren + eigene Werte
# eintragen: cp values-ibm-production.example.yaml values-ibm-production.yaml
/deploy/helm/fiknow/values-ibm-production.yaml
